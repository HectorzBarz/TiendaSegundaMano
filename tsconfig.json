{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "Node",
        "strict": true,
        "jsx": "preserve",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "esModuleInterop": true,
        "lib": ["ESNext", "DOM"],
        "baseUrl": ".",
        "paths": {
            "@/*": ["resources/ts/*"],
            "@volt/*": ["src/volt/*"]
        },
        "types": ["vite/client"]
    },
    "include": [
        "resources/ts/**/*.ts",
        "resources/ts/**/*.vue",
        "src/volt/**/*.ts",
        "src/volt/**/*.vue"
    ]
}
